<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Practice -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_practice"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_max_listen"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/maxListenValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="5"
                    android:textSize="14sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/maxListenSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="5"
                    android:valueFrom="1"
                    android:valueTo="10"
                    android:stepSize="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/settings_max_repeat"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/maxRepeatValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="10"
                    android:textSize="14sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/maxRepeatSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="10"
                    android:valueFrom="1"
                    android:valueTo="20"
                    android:stepSize="1" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Numbers -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_numbers"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_numbers_session_size"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/numbersSessionSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="20"
                    android:textSize="14sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/numbersSessionSizeSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:value="20"
                    android:valueFrom="5"
                    android:valueTo="50"
                    android:stepSize="5" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>