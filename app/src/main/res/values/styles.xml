<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="QuranWords.ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/toggle_button_background</item>
        <item name="android:textColor">@color/toggle_button_text</item>
        <item name="android:minHeight">35dp</item>
        <item name="android:padding">5dp</item>
    </style>


    <style name="FilterDropdownStyle" parent="Widget.MaterialComponents.AutoCompleteTextView.FilledBox">
        <item name="android:drawablePadding">0dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:saveEnabled">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:inputType">none</item>
    </style>


</resources>